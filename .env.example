ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg2://sdlc_user:sdlc_password@127.0.0.1:5432/sdlchub

SECRET_KEY=change-this-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_TIMEOUT=20
USE_CREDENTIALS=true
VALIDATE_CERTS=true

GEMINI_API_KEY=
GOOGLE_API_KEY=

GITHUB_WEBHOOK_SECRET=dev-github-secret

ENABLE_NOTIFICATION_SCHEDULER=true
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_SCHEDULER_INITIAL_DELAY_SECONDS=10
