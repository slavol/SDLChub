ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg2://sdlc_user:sdlc_password@127.0.0.1:5432/sdlchub

SECRET_KEY=change-this-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_TIMEOUT=20
USE_CREDENTIALS=true
VALIDATE_CERTS=true

LOCAL_AI_BASE_URL=http://100.121.227.11:11434
LOCAL_AI_MODEL=qwen2.5-coder:7b
LOCAL_AI_PROVIDER_NAME=Qwen local (Ollama)
LOCAL_AI_AUTO_DETECT=true
LOCAL_AI_CONNECT_TIMEOUT_SECONDS=5
LOCAL_AI_READ_TIMEOUT_SECONDS=120

GITHUB_WEBHOOK_SECRET=dev-github-secret

ENABLE_NOTIFICATION_SCHEDULER=true
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_SCHEDULER_INITIAL_DELAY_SECONDS=10
